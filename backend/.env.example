# Copie para ".env" e ajuste. O .env NUNCA vai para o Git.

# ---- Firebase / Firestore -------------------------------------------------
# 1) Firebase Console → Configurações do projeto → Contas de serviço → "Gerar nova chave privada"
# 2) Salve o JSON na pasta backend/ (ex.: firebase-credenciais.json) e aponte aqui:
FIREBASE_CREDENTIALS=firebase-credenciais.json
# Nome do banco criado no console do Firestore. Deixe vazio se for o "(default)".
FIRESTORE_DATABASE=dbschoolfix
# No Render (sem arquivo), cole o CONTEÚDO do JSON nesta variável em vez do caminho:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# Para testar sem Firebase, use um banco em memória (dados somem ao reiniciar):
# FIRESTORE_MOCK=1

# ---- Segurança ------------------------------------------------------------
# Gere valores aleatórios:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-essa-chave-por-algo-aleatorio
JWT_SECRET_KEY=troque-essa-tambem-por-algo-diferente
JWT_HORAS=8

# Em produção troque "*" pela URL do site (separe várias por vírgula)
CORS_ORIGINS=*

FLASK_DEBUG=1
PORT=5000
